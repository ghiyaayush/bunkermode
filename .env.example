# ── Supabase (single DB for everything) ──────────────────────────────────────
# Dashboard → Settings → Database → Connection string
# Transaction mode (port 6543) = pooled, used by the app at runtime
# Session mode (port 5432) = direct, used by prisma db push only
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Dashboard → Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Telegram bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# ── KeeperHub (optional) ──────────────────────────────────────────────────────
KEEPERHUB_API_KEY=
KEEPERHUB_API_URL=https://api.keeperhub.com

# ── Coinbase CDP / x402 (optional) ───────────────────────────────────────────
CDP_API_KEY=
CDP_API_SECRET=

# ── Anvil fork (optional, local demo only) ────────────────────────────────────
ANVIL_RPC_URL=http://localhost:8545
ANVIL_FORK_BLOCK=22250000
DEMO_WALLET_ADDRESS=
DEMO_WALLET_PRIVATE_KEY=

# ── Signal webhook ────────────────────────────────────────────────────────────
SIGNAL_WEBHOOK_SECRET=dev-secret-change-me
